#include "Version.hpp"
#include <windows.h>
#include <commctrl.h>
1 ICON "assets\\udm.ico"
1 RT_MANIFEST "native\\App.manifest"
100 DIALOGEX 0, 0, 500, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "Tahoma"
BEGIN
END
101 DIALOGEX 0, 0, 500, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
FONT 8, "Tahoma"
BEGIN
END
1 VERSIONINFO
FILEVERSION UDM_VERSION_TUPLE
PRODUCTVERSION UDM_VERSION_TUPLE
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "UDM"
   VALUE "FileDescription", "UDM native C++ download manager"
   VALUE "FileVersion", UDM_VERSION_STRING
   VALUE "ProductName", "UDM Download Manager"
   VALUE "ProductVersion", UDM_VERSION_STRING
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

// Recovery copies of UDM icons for missing or damaged external assets.
1000 RCDATA "assets\\add.png"
1001 RCDATA "assets\\resume.png"
1002 RCDATA "assets\\stop.png"
1003 RCDATA "assets\\stopall.png"
1004 RCDATA "assets\\remove.png"
1005 RCDATA "assets\\complete.png"
1006 RCDATA "assets\\settings.png"
1007 RCDATA "assets\\schedule.png"
1008 RCDATA "assets\\startqueue.png"
1009 RCDATA "assets\\stopqueue.png"
1010 RCDATA "assets\\grabber.png"
1011 RCDATA "assets\\link.png"
