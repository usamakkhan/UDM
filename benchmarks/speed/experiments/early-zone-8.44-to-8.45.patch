--- /dev/null
+++ b/native/InternetZone.hpp
@@ -0,0 +1,24 @@
+#pragma once
+#include "Core.hpp"
+#include <cstring>
+namespace udm {
+enum class InternetZoneResult {Preserved,Written,Unavailable};
+inline constexpr char internetZoneMarker[]="[ZoneTransfer]\r\nZoneId=3\r\n";
+// Only our exact complete marker can skip a write. Do not infer a safe zone
+// from a prefix, partial read, different encoding or an inaccessible stream.
+inline InternetZoneResult ensureInternetZone(const fs::path& file){
+ const auto stream=file.wstring()+L":Zone.Identifier";
+ {
+  Handle existing(CreateFileW(stream.c_str(),GENERIC_READ,FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE,nullptr,OPEN_EXISTING,0,nullptr));
+  LARGE_INTEGER size{};char bytes[sizeof(internetZoneMarker)-1]{};DWORD read=0;
+  if(existing&&GetFileSizeEx(existing.h,&size)&&size.QuadPart==static_cast<LONGLONG>(sizeof(bytes))&&
+     ReadFile(existing.h,bytes,sizeof(bytes),&read,nullptr)&&read==sizeof(bytes)&&
+     std::memcmp(bytes,internetZoneMarker,sizeof(bytes))==0)return InternetZoneResult::Preserved;
+ }
+ Handle output(CreateFileW(stream.c_str(),GENERIC_WRITE,FILE_SHARE_READ,nullptr,CREATE_ALWAYS,0,nullptr));
+ DWORD written=0;
+ if(output&&WriteFile(output.h,internetZoneMarker,sizeof(internetZoneMarker)-1,&written,nullptr)&&written==sizeof(internetZoneMarker)-1)
+  return InternetZoneResult::Written;
+ return InternetZoneResult::Unavailable;
+}
+}
