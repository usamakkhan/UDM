+++ b/native/InternetZoneTests.cpp
@@ -0,0 +1,51 @@
+#include "InternetZone.hpp"
+#include <iostream>
+using namespace udm;
+static void zoneBytes(const fs::path& file,const std::string& bytes){
+ const auto stream=file.wstring()+L":Zone.Identifier";
+ Handle output(CreateFileW(stream.c_str(),GENERIC_WRITE,FILE_SHARE_READ,nullptr,CREATE_ALWAYS,0,nullptr));
+ DWORD written=0;if(!output||!WriteFile(output.h,bytes.data(),static_cast<DWORD>(bytes.size()),&written,nullptr)||written!=static_cast<DWORD>(bytes.size()))throw std::runtime_error("Fixture cannot seed zone stream.");
+}
+static std::string zoneText(const fs::path& file){return readText(fs::path(file.wstring()+L":Zone.Identifier"),32768);}
+int wmain(int argc,wchar_t** argv){
+ if(argc!=2)return 2;const auto root=fs::absolute(argv[1]);if(fs::exists(root))return 2;fs::create_directories(root);
+ Json checks=Json::array();bool passed=false;std::string error;
+ auto check=[&](bool value,const char* label){checks.push_back({{"name",label},{"passed",value}});if(!value)throw std::runtime_error(label);};
+ try{
+  const auto source=root/L"body.part";atomicText(source,"owned complete body",false);const auto hash=fileHash(source);
+  check(ensureInternetZone(source)==InternetZoneResult::Written,"A fresh file receives the full Internet-zone marker");
+  check(zoneText(source)==internetZoneMarker&&fileHash(source)==hash,"Zone creation preserves the body and writes exactly ZoneId 3");
+  {
+   Handle reader(CreateFileW((source.wstring()+L":Zone.Identifier").c_str(),GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,0,nullptr));
+   check(static_cast<bool>(reader),"Fixture holds an existing correct stream with writes excluded");
+   check(ensureInternetZone(source)==InternetZoneResult::Preserved,"Correct metadata is accepted without requesting a rewrite");
+   markZone(source);check(zoneText(source)==internetZoneMarker&&fileHash(source)==hash,"The legacy best-effort markZone entry leaves a read-held correct marker and body intact");
+  }
+  const std::vector<std::string> invalid={"","[ZoneTransfer]\r\nZoneId=1\r\n","[ZoneTransfer]\r\nZoneId=3","[ZoneTransfer]\r\nZoneId=3\r\nextra",std::string(16000,'x'),std::string("\xff\xfe[\0Z\0",6)};
+  for(const auto& bytes:invalid){
+   zoneBytes(source,bytes);
+   check(ensureInternetZone(source)==InternetZoneResult::Written,"Absent, truncated, foreign, extended and differently encoded markers cannot bypass the write");
+   check(zoneText(source)==internetZoneMarker&&fileHash(source)==hash,"Repair truncates invalid metadata to the complete marker without changing bytes");
+  }
+  zoneBytes(source,"changed after preparation");
+  {
+   Handle reader(CreateFileW((source.wstring()+L":Zone.Identifier").c_str(),GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,0,nullptr));
+   check(static_cast<bool>(reader),"Fixture holds invalid metadata against writes");
+   check(ensureInternetZone(source)==InternetZoneResult::Unavailable,"A refused marker repair is not reported as preserved or written");
+   check(zoneText(source)=="changed after preparation"&&fileHash(source)==hash,"A best-effort metadata failure preserves the existing body and stream");
+  }
+  check(ensureInternetZone(source)==InternetZoneResult::Written,"Final verification repairs a changed marker after the refusal is released");
+  check(DeleteFileW((source.wstring()+L":Zone.Identifier").c_str())!=FALSE,"Fixture removes the early marker before final verification");
+  check(ensureInternetZone(source)==InternetZoneResult::Written&&zoneText(source)==internetZoneMarker,"Final verification restores a missing early marker");
+  const auto stage=root/L"stage.assembling",final=root/L"final.bin";
+  check(CreateHardLinkW(stage.c_str(),source.c_str(),nullptr)!=FALSE,"Fixture creates the normal same-volume staging hard link");
+  check(ensureInternetZone(stage)==InternetZoneResult::Preserved&&zoneText(stage)==internetZoneMarker,"Prepared metadata follows the actual body through its staging alias");
+  check(MoveFileExW(stage.c_str(),final.c_str(),0)!=FALSE,"Fixture publishes the staged hard link");
+  check(ensureInternetZone(final)==InternetZoneResult::Preserved&&fileHash(final)==hash,"Publication retains the correct marker without a second metadata write");
+  const auto copied=root/L"copied.bin";atomicText(copied,"owned complete body",false);
+  check(ensureInternetZone(copied)==InternetZoneResult::Written&&zoneText(copied)==internetZoneMarker&&fileHash(copied)==hash,"A body-only copy still gets its own final Internet-zone marker");
+  passed=true;
+ }catch(const std::exception& e){error=e.what();}
+ atomicText(root/L"results.json",Json{{"passed",passed},{"error",error},{"checks",checks}}.dump(2),false);
+ std::cout<<checks.size()<<" checks; "<<(passed?"passed":error)<<"\n";return passed?0:1;
+}
