+ // not retire or change the live row. Wait for pins only outside that mutex.
+ std::optional<Json> tryRetireSnapshot(const Json& live,const std::shared_ptr<const Cancel>& cancel,const std::shared_ptr<Handle>& file){
+  std::lock_guard<std::mutex> lock(state->mutex);current(*state,cancel,file);
+  if(state->writes||state->captures)return {};
+  if(identity(live)!=state->representation)throw std::runtime_error("Disk-credit representation changed before retirement");
+  auto row=projectLocked(live);std::optional<Json> result(std::move(row));state->retired=true;return result;
+ }
+ void waitForPins(){std::unique_lock<std::mutex> lock(state->mutex);state->idle.wait(lock,[&]{return !state->writes&&!state->captures;});}
+};
+}
