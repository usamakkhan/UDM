+ void put(std::size_t offset,const Byte* source,std::size_t length){
+  std::unique_lock<std::mutex> lock(mutex);
+  if(failure)std::rethrow_exception(failure);
+  if(closing)throw std::runtime_error("Buffer has closed");
+  if(offset>total||length>total-offset||(!source&&length))throw std::out_of_range("Invalid buffered span");
+  if(!length)return;
+  const auto end=offset+length;
+  for(const auto& span:accepted){const auto low=std::max(offset,span.first),high=std::min(end,span.second);if(low<high&&!std::equal(source+(low-offset),source+(high-offset),storage->data()+low))throw Conflict("Conflicting buffered bytes");}
