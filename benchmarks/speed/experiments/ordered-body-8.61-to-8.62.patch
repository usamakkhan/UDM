+ }
+public:
+ explicit OrderedBodyWriter(std::size_t size,Writer callback,std::size_t window=256*1024,BodyBufferStorage::Ptr backing={},Failure failed={}):total(checkedSize(size)),chunk(checkedChunk(window,total)),write(checkedWriter(std::move(callback))),notifyFailure(std::move(failed)),storage(checkedStorage(total,std::move(backing))){
