{
  "manifest_version": 3,
  "name": "UDM Browser Integration",
  "version": "0.45.0",
  "description": "UDM download capture, compact video panels, browser request context and persistent desktop integration.",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "webRequest",
    "alarms",
    "webNavigation",
    "proxy"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [],
  "background": {
    "scripts": [
      "formats.js",
      "media.js",
      "native-bridge.js",
      "capture-recovery.js",
      "navigation.js",
      "grabber-session.js",
      "download-session.js",
      "chromium-proxy.js",
      "request-context.js",
      "browser-controls.js",
      "key-capture.js",
      "sites.js",
      "ump.js",
      "streaming-capture.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "UDM Download Manager",
    "default_icon": {
      "64": "icon.png"
    }
  },
  "icons": {
    "64": "icon.png"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-observer.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": [
        "ump.js",
        "capture.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "media.js",
        "content.js",
        "selection.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "udm@local.example",
      "strict_min_version": "128.0"
    }
  }
}
